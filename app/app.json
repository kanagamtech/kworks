{
  "expo": {
    "name": "KwOrKs",
    "slug": "KwOrKs",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-kanagam.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-kanagam.png",
      "resizeMode": "contain",
      "backgroundColor": "#4B1D3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kangamtech.kworks",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "KwOrKs uses your camera to capture your attendance.",
        "NSLocationWhenInUseUsageDescription": "KwOrKs uses your location to record where you mark your attendance.",
        "NSPhotoLibraryUsageDescrAiption": "KwOrKs uses your photo library to set your profile picture."
      }
    },
    "android": {
      "package": "com.kangamtech.kworks",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-kanagam.png",
        "backgroundColor": "#4B1D3F"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo-kanagam.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "KwOrKs uses your photo library to set your profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KwOrKs uses your camera to capture your attendance."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KwOrKs uses your location to record where you mark your attendance."
        }
      ],
      "expo-notifications"
    ],
    "updates": {
      "url": "https://u.expo.dev/569c3d31-192e-426b-ab82-aa908ccd332f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "569c3d31-192e-426b-ab82-aa908ccd332f"
      }
    }
  }
}