# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — exclude actual secrets, but allow example and production
.env
.env.local
.env.*.local
# Allow .env.example (template) and .env.production (no secrets, just URLs)
!.env.example
!.env.production

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Live database data — do not commit
backend/db/kworks_db.json

# Built output
dist/
site/dist/
